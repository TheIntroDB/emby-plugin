<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TheIntroDB</RootNamespace>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2" />
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\locales\*.json" />
    <EmbeddedResource Include="Configuration\locales\*.json" WithCulture="false" LogicalName="TheIntroDB.SettingsLocales.%(Filename)%(Extension)" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheIntroDB.Tests" />
  </ItemGroup>

  <Target Name="EmbedDefaultSettingsLocale" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_SettingsPageSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Configuration/configPage.js'))</_SettingsPageSource>
      <_DefaultSettingsLocale>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Configuration/locales/en.json'))</_DefaultSettingsLocale>
      <_SettingsPageSource>$(_SettingsPageSource.Replace('/* DEFAULT_LOCALE */ null', '$(_DefaultSettingsLocale)'))</_SettingsPageSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)configPage.js" Lines="$([MSBuild]::Escape('$(_SettingsPageSource)'))" Encoding="UTF-8" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)configPage.js" LogicalName="TheIntroDB.Configuration.configPage.js" />
    </ItemGroup>
  </Target>

</Project>
