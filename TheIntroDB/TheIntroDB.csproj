<Project Sdk="Microsoft.NET.Sdk">

  <UsingTask TaskName="EmbedDefaultSettingsLocale" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <LocaleDirectory ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(SourceFile);
        var localeFiles = Directory.GetFiles(LocaleDirectory, "*.json");
        System.Array.Sort(localeFiles, System.StringComparer.OrdinalIgnoreCase);

        var locales = new System.Text.StringBuilder();
        locales.Append("{");
        foreach (var file in localeFiles)
        {
            var name = Path.GetFileNameWithoutExtension(file);
            locales.Append("\"").Append(name.Replace("\\", "\\\\").Replace("\"", "\\\"")).Append("\":");
            locales.Append(File.ReadAllText(file).Trim());
            locales.Append(",");
        }
        if (localeFiles.Length > 0) locales.Length -= 1;
        locales.Append("}");

        var generated = source.Replace("/* EMBEDDED_LOCALES */ null", locales.ToString());
        var directory = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(directory)) Directory.CreateDirectory(directory);
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != generated)
        {
            File.WriteAllText(OutputFile, generated, new System.Text.UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TheIntroDB</RootNamespace>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2" />
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Configuration\configPage.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Configuration\locales\*.json" />
    <EmbeddedResource Include="Configuration\locales\*.json" WithCulture="false" LogicalName="TheIntroDB.SettingsLocales.%(Filename)%(Extension)" />
    <EmbeddedResource Include="thumb.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheIntroDB.Tests" />
  </ItemGroup>

  <Target Name="GenerateSettingsPageScript" BeforeTargets="AssignTargetPaths">
    <EmbedDefaultSettingsLocale
      SourceFile="$(MSBuildProjectDirectory)/Configuration/configPage.js"
      LocaleFile="$(MSBuildProjectDirectory)/Configuration/locales/en.json"
      OutputFile="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)configPage.js" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)configPage.js" LogicalName="TheIntroDB.Configuration.configPage.js" />
    </ItemGroup>
  </Target>

</Project>
